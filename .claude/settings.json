{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "teammateMode": "auto",
  "permissions": {
    "allow": ["Read(//Users/alex/.claude/**)"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
