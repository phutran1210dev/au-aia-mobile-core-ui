{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "teammateMode": "auto",
  "permissions": {
    "allow": ["Read(//Users/alex/.claude/**)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-git.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "yarn typecheck >&2 && yarn lint >&2 || exit 2"
          }
        ]
      }
    ]
  }
}
